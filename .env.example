# Copy this file to .env and fill in the values for your deployment.
# .env is git-ignored: never commit real credentials.

# --- Apache Jena Fuseki ---------------------------------------------------
# The dataset is named brickESPOL in Services/fuseki/config.ttl.
FUSEKI_SPARQL_ENDPOINT=http://localhost:3030/brickESPOL/sparql
FUSEKI_UPDATE_ENDPOINT=http://localhost:3030/brickESPOL/update
FUSEKI_USER=admin
FUSEKI_PASSWORD=

# --- MongoDB --------------------------------------------------------------
# Connection string for the operational store the graph points into.
MONGODB_ENDPOINT=mongodb://localhost:27017

# --- Evaluation scripts only ----------------------------------------------
# Base URL of the Fuseki server, without the dataset path. Used by the scripts
# that create and drop in-memory datasets (07, 09, 11).
FUSEKI_BASE=http://localhost:3030

# Optional knobs, all with defaults in the scripts themselves:
#   TRIALS      repetitions per measurement          (07, 08, 09, 11, 13)
#   TIMED       timed queries inside each trial      (07, 08, 11, 13)
#   FACTORS     replication factors for scalability  (07, 11)
#   VOLUMES     readings per point to load           (09)
#   LABORATORY  local name of the laboratory queried (13)

# Django. DEBUG=1 is the development default; set it to 0 for
# anything reachable from outside. DJANGO_ALLOWED_HOSTS is
# comma-separated and must name the host clients ask for.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
