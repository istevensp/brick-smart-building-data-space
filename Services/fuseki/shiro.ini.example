# Copy to shiro.ini and set a password before starting Fuseki.
# shiro.ini itself is git-ignored so the credential never ships.
[main]
ssl.enabled = false

plainMatcher = org.apache.shiro.authc.credential.SimpleCredentialsMatcher
iniRealm.credentialsMatcher = $plainMatcher

[users]
admin = CHANGE_ME_BEFORE_EXPOSING

[urls]
/$/status = anon
/$/ping   = anon
/$/** = authcBasic, user[admin]

/**/sparql   = authcBasic, user[admin]
/**/get     = authcBasic, user[admin]
/**/update  = authcBasic, user[admin]
/**/schema  = authcBasic, user[admin]
/**/patch   = authcBasic, user[admin]

/** = anon
